{
	"name": "chispa",
	"version": "0.10.3",
	"description": "A fully declarative UI reactive engine for building web applications.",
	"author": "José Carlos HR <joecarlhr@gmail.com>",
	"license": "MIT",
	"type": "module",
	"sideEffects": false,
	"main": "dist/index.js",
	"types": "dist/index.d.ts",
	"files": [
		"dist"
	],
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		},
		"./vite-plugin": {
			"types": "./dist/html-compiler/vite-plugin.d.ts",
			"import": "./dist/html-compiler/vite-plugin.js"
		}
	},
	"bin": {
		"chispa-cli": "dist/html-compiler/cli.js"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/joecarl/chispa.git"
	},
	"dependencies": {
		"jsdom": "^30.0.1",
		"prettier": "^3.9.6"
	},
	"peerDependencies": {
		"vite": ">=7"
	},
	"peerDependenciesMeta": {
		"vite": {
			"optional": true
		}
	},
	"devDependencies": {
		"@types/jsdom": "^30.0.0",
		"tsdown": "^0.22.14",
		"typescript": "^7.0.2",
		"vite": "^8.2.2",
		"vitest": "^4.1.11"
	},
	"bugs": {
		"url": "https://github.com/joecarl/chispa/issues"
	},
	"homepage": "https://github.com/joecarl/chispa#readme",
	"scripts": {
		"build": "tsdown",
		"start": "echo \"Error: no dev mode available\" && exit 1",
		"test": "vitest run",
		"test:watch": "vitest",
		"prepublishOnly": "npm run build"
	}
}
